{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dmaynor/cheddar_framework/schemas/flow_initiative.schema.json",
  "title": "Flow Initiative",
  "description": "Translates mission intent into departmental or system-level objectives",
  "type": "object",

  "properties": {
    "level": { "type": "string", "const": "flow_initiative" },
    "id": { "type": "string", "pattern": "^flow_[a-z0-9_]+_v[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "supports_upper_layer": { "type": "string", "pattern": "^mission_[a-z0-9_]+_v[0-9]+$" },
    "objective": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "telemetry_signals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "enables_lower_layer": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "upward_feedback": { "type": "string" },
    "cheddar_state": { "type": "string", "enum": ["active","resolved","stinky"] },
    "lineage": {
      "type": "object",
      "properties": {
        "upstream_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "signed_by": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["upstream_hash","hash","timestamp"],
      "additionalProperties": false
    }
  },

  "required": ["level","id","title","supports_upper_layer","objective","lineage"],
  "additionalProperties": false
}
